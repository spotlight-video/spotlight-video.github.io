# Spotlight project page — Jekyll on GitHub Pages.
#
# We pin to the `github-pages` gem so local builds match exactly what GitHub
# Pages runs in production. Run locally with:  bundle exec jekyll serve
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

# Faster, cross-platform file watching for `jekyll serve` on macOS/Windows.
gem "wdm", "~> 0.1.1", platforms: [:mingw, :x64_mingw, :mswin]
gem "webrick", "~> 1.8" # required for `jekyll serve` on Ruby 3+
